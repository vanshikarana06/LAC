# Never bake secrets into an image — same reasoning as .gitignore for .env.
.env

# Your local venv — irrelevant and huge; the image builds its own clean environment.
venv/

# Python cache files — regenerated automatically, no reason to ship them.
__pycache__/
*.pyc

# The vector database — see note below on how this gets handled for Docker.
data_vector_db/
data_vector_db_backup/
data_vector_db_test/

# Local git metadata — not needed inside the running container.
.git/
.gitignore

# Local session storage — this is runtime data, not something to bake into the image.
session_store.db

# Evaluation output/scripts — not part of the running application.
ragas_results*.csv
scripts/