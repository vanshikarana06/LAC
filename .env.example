# API Keys — Required
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Embeddings Backend ("fastembed" [default, no torch] or "local-torch" [dev only])
EMBEDDING_BACKEND=fastembed

# Model Selection (Note: Render deployment requires GROQ_MODEL env var in dashboard if default changes)
GROQ_MODEL=openai/gpt-oss-20b

# Vector Database Path
DB_PATH=data_vector_db

# Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=legal-advisor-ai

