# API Keys — Required
GROQ_API_KEY=gsk_your_groq_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here
HF_TOKEN=hf_your_huggingface_token_here

# Model Selection (Note: Render deployment requires GROQ_MODEL env var in dashboard if default changes)
GROQ_MODEL=openai/gpt-oss-20b

# Vector Database Path
DB_PATH=data_vector_db

# Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
LANGCHAIN_PROJECT=legal-advisor-ai

